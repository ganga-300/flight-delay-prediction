# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Testing / tooling ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (keep folder structure, ignore contents) ---
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
*.csv
*.parquet
*.zip
# Raw dataset is versioned so the pipeline runs from a fresh clone (42.9 MB, < GitHub's 50 MB warning).
!data/raw/flights.csv

# --- Model artifacts ---
models/*
!models/.gitkeep
*.pkl
*.joblib
*.ubj

# --- Generated outputs ---
reports/results/*
!reports/results/.gitkeep

# --- LaTeX build files ---
report/*.aux
report/*.bbl
report/*.blg
report/*.log
report/*.out
report/*.synctex.gz
report/*.fdb_latexmk
report/*.fls
report/*.toc
report/*.pdf

# --- Secrets ---
.env
kaggle.json

